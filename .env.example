# ==========================================
# Razorpay Payment Gateway Configuration
# ==========================================
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# ==========================================
# Google Gemini AI API Configuration
# ==========================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ==========================================
# Email / SMTP Configuration
# ==========================================
EMAIL_USER="your_email@example.com"
EMAIL_PASS="your_email_app_password"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465

# Optional SMTP fallbacks
# SMTP_USER="your_email@example.com"
# SMTP_PASS="your_email_app_password"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587

# ==========================================
# Application URL
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# DigiLocker Integration (OAuth)
# ==========================================
DIGILOCKER_CLIENT_ID="your_digilocker_client_id"
DIGILOCKER_CLIENT_SECRET="your_digilocker_client_secret"
DIGILOCKER_REDIRECT_URI="http://localhost:3000/api/auth/digilocker/callback"

# ==========================================
# Database Connection
# ==========================================
mongo_uri="mongodb+srv://<username>:<password>@cluster.mongodb.net/interns_portal?retryWrites=true&w=majority"

# ==========================================
# Cron Automation Secret
# ==========================================
CRON_SECRET="your_cron_secret_token"

# ==========================================
# Streamlet / S3 Object Storage Configuration
# ==========================================
STREAMLET_API_KEY="your_streamlet_api_key"
STREAMLET_ACCOUNT_NUMBER="your_streamlet_account_number"
STREAMLET_REGION="ap-south-1"
STREAMLET_ENDPOINT="https://s3.streamlet.in"
STREAMLET_ACCESS_KEY="your_streamlet_access_key"
STREAMLET_SECRET_KEY="your_streamlet_secret_key"
STREAMLET_BUCKET_NAME="interns-portal"
STREAMLET_CDN_URL="https://cdn.streamlet.in"
